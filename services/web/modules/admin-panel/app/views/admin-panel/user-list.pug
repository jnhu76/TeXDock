extends ../../../../../app/views/layout-marketing

block content
  .container
    .page-header
      h1 User Management

    ul.nav.nav-tabs.mb-4
      li.nav-item
        a.nav-link.active(data-bs-toggle='tab', href='#users') Users
      li.nav-item
        a.nav-link(data-bs-toggle='tab', href='#license') License Usage

    .tab-content
      #users.tab-pane.fade.show.active
        .card
          .card-body
            form.mb-3.d-flex.gap-2(method='GET', action='/admin/user')
              .input-group
                input.form-control(
                  type='text',
                  name='search',
                  placeholder='Search users by email or id…',
                  value=search
                )
              .form-check
                input.form-check-input(
                  type='checkbox',
                  name='searchType',
                  value='regexp',
                  id='regexpCheck',
                  checked=searchType === 'regexp'
                )
                label.form-check-label(for='regexpCheck') RegExp
              button.btn.btn-primary(type='submit') Search
              a.btn.btn-success(href='/admin/register') New User

            if users.length > 0
              table.table.table-striped
                thead
                  tr
                    th Email
                    th Created
                    th Last Login
                    th Admin
                tbody
                  each user in users
                    tr
                      td
                        a(href=`/admin/user/${user._id}`)= user.email || 'No email'
                      td= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : '-'
                      td= user.lastLoggedInAt ? new Date(user.lastLoggedInAt).toLocaleDateString() : '-'
                      td= user.isAdmin ? 'Yes' : 'No'
            else if search
              p.text-muted No users found.

      #license.tab-pane.fade
        .card
          .card-body
            p An active user is one who has opened a project in this Server Pro instance in the last 12 months.

    script(src='/socket.io/socket.io.js')
