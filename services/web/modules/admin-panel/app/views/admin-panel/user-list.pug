extends ../../../../../app/views/layout-marketing
include ../../../../../app/views/_mixins/bookmarkable_tabset

block content
	.content.content-alt#main-content
		.container
			.row
				.col-sm-12
					.card
						.card-body
							.page-header
								h1 User Management
							.ol-tabs(data-ol-bookmarkable-tabset)
								.nav-tabs-container
									ul.nav.nav-tabs.align-left(role="tablist")
										+bookmarkable-tabset-header('users', 'Users', true)
										+bookmarkable-tabset-header('license', 'License Usage')

							.tab-content
								.tab-pane.active(
									role="tabpanel"
									id='users'
								)
									.row-spaced
										form(method='GET', action='/admin/user')
											.row
												.col-xs-12
													.form-group
														.input-group
															input.form-control(
																type='text'
																name='search'
																placeholder='Search users by email or id…'
																value=search
															)
															span.input-group-addon
																input(
																	type='checkbox'
																	name='searchType'
																	value='regexp'
																	checked=(searchType === 'regexp')
																)
															span.input-group-addon RegExp
															span.input-group-btn
																button.btn.btn-primary(type='submit') Search
																a.btn.btn-success(href='/admin/register') New User

									if users.length > 0
										table.table.table-striped
											thead
												tr
													th Email
													th Signed Up
													th Last Login
													th Logins
													th Admin
											tbody
												each user in users
													tr
														td
															a(href='/admin/user/' + user._id)= user.email || 'No email'
														td= user.signUpDate ? new Date(user.signUpDate).toLocaleDateString() : '-'
														td= user.lastLoggedIn ? new Date(user.lastLoggedIn).toLocaleDateString() : '-'
														td= user.loginCount || 0
														td= user.isAdmin ? 'Yes' : 'No'
									else if search
										p No users found.

								.tab-pane(
									role="tabpanel"
									id='license'
								)
									.row-spaced
										p An active user is one who has opened a project in this Server Pro instance in the last 12 months.
