extends ../../../../../app/views/layout-marketing
include ../../../../../app/views/_mixins/bookmarkable_tabset

block content
	.content.content-alt#main-content
		.container
			.row
				.col-sm-12
					.card
						.card-body
							.page-header
								h1= user.email || 'User Details'
								p.small.text-muted ID: #{user._id}

							.ol-tabs(data-ol-bookmarkable-tabset)
								.nav-tabs-container
									ul.nav.nav-tabs.align-left(role="tablist")
										+bookmarkable-tabset-header('info', 'User Info', true)
										+bookmarkable-tabset-header('projects', 'Projects (' + projects.length + ')')
										+bookmarkable-tabset-header('deleted', 'Deleted Projects (' + deletedProjects.length + ')')
										+bookmarkable-tabset-header('audit', 'Audit Log')

							.tab-content
								.tab-pane.active(
									role="tabpanel"
									id='info'
								)
									table.table
										tr
											th Email
											td= user.email || '-'
										tr
											th Signed Up
											td= user.signUpDate ? new Date(user.signUpDate).toLocaleString() : '-'
										tr
											th Last Login
											td= user.lastLoggedIn ? new Date(user.lastLoggedIn).toLocaleString() : '-'
										tr
											th Login Count
											td= user.loginCount || 0
										tr
											th Last Login IP
											td= user.lastLoginIp || '-'
										tr
											th isAdmin
											td= user.isAdmin ? 'Yes' : 'No'
										tr
											th Holding Account
											td= user.holdingAccount ? 'Yes' : 'No'

								.tab-pane(
									role="tabpanel"
									id='projects'
								)
									if projects.length > 0
										table.table.table-striped
											thead
												tr
													th Name
													th Created
													th Last Updated
											tbody
												each project in projects
													tr
														td
															a(href='/admin/project/' + project._id)= project.name
														td= project.createdAt ? new Date(project.createdAt).toLocaleDateString() : '-'
														td= project.lastUpdated ? new Date(project.lastUpdated).toLocaleDateString() : '-'
									else
										p No projects found.

								.tab-pane(
									role="tabpanel"
									id='deleted'
								)
									if deletedProjects.length > 0
										table.table.table-striped
											thead
												tr
													th Name
													th Deleted At
											tbody
												each project in deletedProjects
													tr
														td= project.name || '-'
														td= project.deleted ? new Date(project.deleted).toLocaleDateString() : '-'
									else
										p No deleted projects.

								.tab-pane(
									role="tabpanel"
									id='audit'
								)
									if auditLog && auditLog.length > 0
										table.table.table-striped
											thead
												tr
													th Action
													th Timestamp
													th Details
											tbody
												each entry in auditLog
													tr
														td= entry.operation || '-'
														td= entry.timestamp ? new Date(entry.timestamp).toLocaleString() : '-'
														td
															pre.small= JSON.stringify(entry.info || {}, null, 2)
									else
										p No audit log entries.
