extends ../../../../../app/views/layout-marketing

block content
  .container
    .page-header
      h1= project.name || 'Project Details'
      p.text-muted ID: #{project._id}

    ul.nav.nav-tabs.mb-4
      li.nav-item
        a.nav-link.active(data-bs-toggle='tab', href='#info') Project Info
      li.nav-item
        a.nav-link(data-bs-toggle='tab', href='#deleted-docs') Deleted Docs
      li.nav-item
        a.nav-link(data-bs-toggle='tab', href='#audit') Audit Log

    .tab-content
      #info.tab-pane.fade.show.active
        .card.mb-4
          .card-header
            h5 Project Information
          .card-body
            table.table
              tr
                th Name
                td= project.name || '-'
              tr
                th Owner
                td
                  if owner
                    a(href=`/admin/user/${owner._id}`)= owner.email
                  else
                    | -
              tr
                th Created
                td= project.createdAt ? new Date(project.createdAt).toLocaleString() : '-'
              tr
                th Last Updated
                td= project.lastUpdated ? new Date(project.lastUpdated).toLocaleString() : '-'

        .card.mb-4
          .card-header
            h5 Actions
          .card-body
            form(method='POST', action=`/admin/project/${project._id}/undelete`)
              input(type='hidden', name='_csrf', value=csrfToken)
              button.btn.btn-warning(type='submit') Undelete

        .card
          .card-header
            h5 Transfer Ownership
          .card-body
            form(method='POST', action=`/admin/project/${project._id}/transfer`)
              input(type='hidden', name='_csrf', value=csrfToken)
              .input-group
                input.form-control(
                  type='text',
                  name='targetUserId',
                  placeholder='User ID or Email'
                )
                button.btn.btn-primary(type='submit') Transfer

      #deleted-docs.tab-pane.fade
        .card
          .card-body
            if project.deletedDocs && project.deletedDocs.length > 0
              table.table.table-striped
                thead
                  tr
                    th Name
                    th Deleted At
                tbody
                  each doc in project.deletedDocs
                    tr
                      td= doc.name || '-'
                      td= doc.deleted ? new Date(doc.deleted).toLocaleDateString() : '-'
            else
              p.text-muted No deleted documents.

      #audit.tab-pane.fade
        .card
          .card-body
            if auditLog && auditLog.length > 0
              table.table.table-striped
                thead
                  tr
                    th Action
                    th Timestamp
                    th Details
                tbody
                  each entry in auditLog
                    tr
                      td= entry.operation || '-'
                      td= entry.timestamp ? new Date(entry.timestamp).toLocaleString() : '-'
                      td= JSON.stringify(entry.info || {})
            else
              p.text-muted No audit log entries.

    script(src='/socket.io/socket.io.js')
