#!/usr/bin/env bash
set -Eeuo pipefail

ZIP_FILE="${1:-}"
TARGET_DIR="${2:-/usr/local/share/fonts/private}"

if [ -z "${ZIP_FILE}" ]; then
  echo "Usage:"
  echo "  import-private-fonts-zip /path/to/fonts.zip [target-font-dir]"
  exit 1
fi

if [ ! -f "${ZIP_FILE}" ]; then
  echo "ERROR: fonts zip not found: ${ZIP_FILE}"
  exit 1
fi

if ! command -v unzip >/dev/null 2>&1; then
  echo "ERROR: unzip is required."
  exit 1
fi

mkdir -p "${TARGET_DIR}"

TMP_DIR="$(mktemp -d)"

cleanup() {
  rm -rf "${TMP_DIR}"
}
trap cleanup EXIT

echo "Importing private fonts:"
echo "  zip    : ${ZIP_FILE}"
echo "  target : ${TARGET_DIR}"
echo

# Extract into a temp directory first.
unzip -q "${ZIP_FILE}" -d "${TMP_DIR}/extract"

copied=0

while IFS= read -r -d '' font; do
  base="$(basename "${font}")"

  # Normalize dangerous names; do not preserve zip paths.
  safe_base="$(echo "${base}" | tr -cd 'A-Za-z0-9._ -')"

  if [ -z "${safe_base}" ]; then
    echo "Skipping suspicious file name: ${base}"
    continue
  fi

  dest="${TARGET_DIR}/${safe_base}"

  if [ -e "${dest}" ]; then
    stem="${safe_base%.*}"
    ext="${safe_base##*.}"
    dest="${TARGET_DIR}/${stem}-$(date +%s%N).${ext}"
  fi

  echo "Copying font: ${font} -> ${dest}"
  cp -f "${font}" "${dest}"
  chmod 0644 "${dest}"
  copied=$((copied + 1))
done < <(
  find "${TMP_DIR}/extract" -type f \( \
    -iname '*.ttf' -o \
    -iname '*.ttc' -o \
    -iname '*.otf' -o \
    -iname '*.otc' \
  \) -print0
)

echo
echo "Copied ${copied} font file(s)."

if [ "${copied}" -eq 0 ]; then
  echo "ERROR: no font files found in zip."
  echo "Expected: .ttf, .ttc, .otf, .otc"
  exit 1
fi

refresh-texlive-font-cache
