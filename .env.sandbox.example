# .env.sandbox.example
#
# Copy this file to .env.sandbox and edit it.
#
# Do not commit .env.sandbox.
# Use absolute host paths visible to the Docker daemon.
# Do not use "~" here.

# ---------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------

TEXDOCK_WEB_IMAGE=texdock/sharelatex-web:latest
TEXDOCK_TEXLIVE_IMAGE=texdock/texlive:2026.1

TEXDOCK_MONGO_IMAGE=mongo:8.0
TEXDOCK_REDIS_IMAGE=redis:6.2

# ---------------------------------------------------------------------
# Host paths
# ---------------------------------------------------------------------

TEXDOCK_OVERLEAF_DATA_DIR=/path/to/sharelatex_data
TEXDOCK_MONGO_DATA_DIR=/path/to/mongo_data
TEXDOCK_REDIS_DATA_DIR=/path/to/redis_data

# This file must exist relative to the compose file,
# or use an absolute path.
TEXDOCK_MONGO_INIT_SCRIPT=./bin/shared/mongodb-init-replica-set.js

# ---------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------

TEXDOCK_HTTP_PORT=80

# ---------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------

TZ=Asia/Shanghai
OVERLEAF_SITE_LANGUAGE=zh-CN

# ---------------------------------------------------------------------
# Overleaf basic settings
# ---------------------------------------------------------------------

OVERLEAF_APP_NAME=Overleaf Community Edition

ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
ENABLE_CONVERSIONS=true
EMAIL_CONFIRMATION_DISABLED=true
MAX_COMPILE_TIMEOUT_MINUTES=10

# For public deployment, set these.
# OVERLEAF_SITE_URL=http://overleaf.example.com
# OVERLEAF_SESSION_SECRET=change-this-to-a-random-string

# ---------------------------------------------------------------------
# Sandbox compile settings
# ---------------------------------------------------------------------

SANDBOXED_COMPILES=true
DOCKER_RUNNER=true
SANDBOXED_COMPILES_SIBLING_CONTAINERS=true
SANDBOXED_COMPILES_DISABLE_SECCOMP=true

# Must match the compile user in the TeXLive sibling image.
TEXLIVE_IMAGE_USER=33:33

# ---------------------------------------------------------------------
# Optional container names
# ---------------------------------------------------------------------

TEXDOCK_SHARELATEX_CONTAINER=sharelatex
TEXDOCK_MONGO_CONTAINER=mongo
TEXDOCK_REDIS_CONTAINER=redis

# ---------------------------------------------------------------------
# Mongo
# ---------------------------------------------------------------------

MONGO_INITDB_DATABASE=sharelatex
