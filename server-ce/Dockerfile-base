# --------------------------------------------------
# Overleaf Base Image (sharelatex/sharelatex-base)
# --------------------------------------------------

FROM phusion/baseimage:noble-1.0.3

# Makes sure LuaTex cache is writable
# -----------------------------------
ENV TEXMFVAR=/var/lib/overleaf/tmp/texmf-var

# Update to ensure dependencies are updated
# ------------------------------------------
ENV REBUILT_AFTER="2026-05-21"

# China mirrors
# -------------
ARG UBUNTU_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu
ARG NODESOURCE_MIRROR=https://repo.huaweicloud.com/nodesource
ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG TEXLIVE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/CTAN/systems/texlive/tlnet

# Install dependencies
# --------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    set -eux; \
    \
    # Enable apt package cache
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache; \
    \
    # Use China Ubuntu mirror.
    # Ubuntu 24.04/noble commonly uses DEB822 format:
    # /etc/apt/sources.list.d/ubuntu.sources
    if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
      cp /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources.bak; \
      cat > /etc/apt/sources.list.d/ubuntu.sources <<EOF
Types: deb
URIs: ${UBUNTU_MIRROR}
Suites: noble noble-updates noble-backports noble-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
EOF
    fi; \
    \
    # Fallback for old-style sources.list, if present.
    if [ -f /etc/apt/sources.list ]; then \
      cp /etc/apt/sources.list /etc/apt/sources.list.bak; \
      sed -i \
        -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
        -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
        -e "s|http://ports.ubuntu.com/ubuntu-ports|${UBUNTU_MIRROR}|g" \
        /etc/apt/sources.list; \
    fi; \
    \
    apt-get update; \
    apt-get install -y \
      unattended-upgrades \
      build-essential \
      wget \
      net-tools \
      unzip \
      time \
      poppler-utils \
      optipng \
      strace \
      nginx \
      git \
      python3 \
      python-is-python3 \
      zlib1g-dev \
      libpcre3-dev \
      gettext-base \
      libwww-perl \
      ca-certificates \
      curl \
      gnupg \
      qpdf; \
    \
    # Upgrade base-image packages after switching apt mirror.
    unattended-upgrade --verbose --no-minimal-upgrade-steps; \
    \
    # Install Node.js 22.x from domestic NodeSource mirror.
    # The GPG key is still fetched from NodeSource official endpoint.
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] ${NODESOURCE_MIRROR}/node_22.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list; \
    apt-get update; \
    apt-get install -y nodejs; \
    \
    # Use domestic npm registry.
    npm config set registry "${NPM_REGISTRY}"; \
    \
    rm -rf \
      /etc/nginx/nginx.conf \
      /etc/nginx/sites-enabled/default
