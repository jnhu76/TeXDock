# Dockerfile-full
#
# Build a TeXDock / Overleaf CE image with full TeX Live and common CJK fonts.
#
# Base image:
#   fred1653/sharelatex:latest
#
# Build:
#   docker build -f server-ce/Dockerfile-full -t fred1653/sharelatex-full:latest .
#
# Notes:
# - The base image is expected to already contain a working TeX Live + tlmgr.
# - TEXLIVE_REPOSITORY is optional. Leave it empty to use the repository already
#   configured in the base image. Set it when you want to force a specific CTAN
#   mirror, for example:
#     --build-arg TEXLIVE_REPOSITORY=https://mirrors.tuna.tsinghua.edu.cn/CTAN/systems/texlive/tlnet
# - If the base image uses an older TeX Live year, do not point tlmgr at the
#   latest tlnet. Use the matching historic tlnet-final repository instead.

FROM fred1653/sharelatex:latest

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

# Optional CTAN / TeX Live repository override.
# Example:
#   https://mirrors.tuna.tsinghua.edu.cn/CTAN/systems/texlive/tlnet
ARG TEXLIVE_REPOSITORY=""

# Install common runtime tools and CJK fonts.
#
# fonts-noto-cjk / fonts-noto-cjk-extra:
#   broad Simplified Chinese, Traditional Chinese, Japanese, Korean coverage.
# fonts-wqy-*:
#   useful fallback fonts for older Chinese templates.
# fonts-arphic-*:
#   useful for some CJK / legacy documents.
# fontconfig:
#   required by XeLaTeX/LuaLaTeX font discovery.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      fontconfig \
      fonts-noto-cjk \
      fonts-noto-cjk-extra \
      fonts-noto-color-emoji \
      fonts-wqy-microhei \
      fonts-wqy-zenhei \
      fonts-arphic-ukai \
      fonts-arphic-uming \
      ghostscript \
      make \
      perl \
      xz-utils \
    ; \
    rm -rf /var/lib/apt/lists/*; \
    fc-cache -fv

# Upgrade the minimal TeX Live installation to scheme-full.
#
# Required sequence:
#   1. optionally set repository
#   2. tlmgr update --self
#   3. tlmgr update --all
#   4. tlmgr install scheme-full
#   5. tlmgr path add
#
# Overleaf notes that tlmgr path add is required after tlmgr install so that
# binaries are symlinked into the system path.
RUN set -eux; \
    tlmgr --version; \
    if [[ -n "${TEXLIVE_REPOSITORY}" ]]; then \
      tlmgr option repository "${TEXLIVE_REPOSITORY}"; \
    fi; \
    tlmgr option repository; \
    tlmgr update --self; \
    tlmgr update --all; \
    tlmgr install scheme-full; \
    tlmgr path add; \
    mktexlsr; \
    updmap-sys; \
    luaotfload-tool --update || true; \
    fc-cache -fv; \
    latex --version; \
    xelatex --version; \
    lualatex --version

# Smoke test: compile a tiny Chinese document with XeLaTeX.
# This verifies ctex + CJK font discovery at image build time.
RUN set -eux; \
    mkdir -p /tmp/texlive-smoke; \
    cat > /tmp/texlive-smoke/main.tex <<'EOF'; \
\documentclass{ctexart}
\begin{document}
中文测试 TeXDock.
\[
  E = mc^2
\]
\end{document}
EOF
    cd /tmp/texlive-smoke; \
    xelatex -interaction=nonstopmode -halt-on-error main.tex; \
    test -s main.pdf; \
    rm -rf /tmp/texlive-smoke

# Keep the original image entrypoint/cmd from fred1653/sharelatex:latest.
