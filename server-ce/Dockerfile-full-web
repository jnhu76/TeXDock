# server-ce/Dockerfile-full-web
#
# 基于 full-base（含完整 TeX Live + 中文字体），仅覆盖 web 代码。
# 日常 web 修改后只需 rebuild 此层，无需重新安装 TeX Live。
#
# 用法:
#   docker build -f server-ce/Dockerfile-full-web -t fred1653/sharelatex-full:latest .

FROM fred1653/sharelatex-full:latest

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY libraries/ /overleaf/libraries/
COPY services/web/ /overleaf/services/web/

RUN set -eux; \
    cd /overleaf; \
    node genScript compile | bash

RUN set -eux; \
    cd /overleaf/services/web; \
    node --check app.mjs
