# server-ce/Dockerfile-full-web
#
# Web-only rebuild on top of sharelatex-full.
# Rebuild this after web code changes — no TeX Live reinstall needed.
#
# Build:
#   docker build -f server-ce/Dockerfile-full-web -t texdock/sharelatex-full:latest .

ARG BASE_IMAGE=texdock/sharelatex-full:latest
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY libraries/ /overleaf/libraries/
COPY services/web/ /overleaf/services/web/

RUN set -eux; \
    cd /overleaf; \
    node genScript compile | bash

RUN set -eux; \
    cd /overleaf/services/web; \
    node --check app.mjs
