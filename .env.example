# .env.example for docker-compose.yml (full image mode)
#
# Copy this file to .env and edit it.
# Do not commit .env.
# Use absolute host paths visible to the Docker daemon.

# Images
TEXDOCK_FULL_IMAGE=texdock/sharelatex-full:latest
TEXDOCK_MONGO_IMAGE=mongo:8.0
TEXDOCK_REDIS_IMAGE=redis:6.2

# Host paths (must be absolute)
TEXDOCK_OVERLEAF_DATA_DIR=/path/to/sharelatex_data
TEXDOCK_MONGO_DATA_DIR=/path/to/mongo_data
TEXDOCK_REDIS_DATA_DIR=/path/to/redis_data

# Network
TEXDOCK_HTTP_PORT=80

# Locale
TZ=Asia/Shanghai
OVERLEAF_SITE_LANGUAGE=zh-CN

# Overleaf settings
OVERLEAF_APP_NAME=Overleaf Community Edition
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
ENABLE_CONVERSIONS=true
EMAIL_CONFIRMATION_DISABLED=true
MAX_COMPILE_TIMEOUT_MINUTES=10

# Optional (uncomment as needed)
# OVERLEAF_SITE_URL=http://your-server-ip
# OVERLEAF_SESSION_SECRET=change-this-to-a-random-string
# ADMIN_PRIVILEGE_AVAILABLE=true
